# Live CALL-E calls are disabled unless all three live settings are explicit.
CALLE_API_KEY=
CALLE_API_KEY_FILE=
CALLE_BASE_URL=https://api.heycall-e.com
OPENLINE_MODE=simulation
OPENLINE_LIVE_CONFIRM=false
CALLE_POLL_MS=60000
CALLE_TIMEOUT_MS=300000
CALLE_HTTP_TIMEOUT_MS=30000

# Replace the fixture numbers before enabling live calls. These must be numbers
# you are authorized to contact, should be E.164, and must match a region and
# language currently supported by CALL-E.
OPENLINE_LIVE_PROVIDER_ID=live-test-recipient
OPENLINE_TEST_PHONE=
OPENLINE_TEST_CITY=
OPENLINE_TEST_REGION=
